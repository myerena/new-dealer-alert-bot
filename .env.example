# New Dealer Alert Bot Configuration
# Copy to .env and adjust values

# Database path (SQLite)
DATABASE_PATH=data/dealer_alert.db

# Crawl settings
MAX_CONCURRENT_FETCHES=10
FETCH_TIMEOUT_SECONDS=30
CRAWL_DELAY_SECONDS=2
USER_AGENT=DealerAlertBot/1.0 (lead-research)
MAX_REDIRECTS=5

# Output settings
OUTPUT_DIR=data/digests
OUTPUT_FORMAT=both  # csv, json, or both

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/dealer_alert.log

# Expansion engine
AUTO_EXPAND=true
MAX_EXPANSION_DEPTH=2
MAX_NEW_SOURCES_PER_CRAWL=100

# Scoring thresholds
HOT_LEAD_MIN_MENTIONS=2
WARM_LEAD_KEYWORDS=hiring,construction,coming-soon,teaser
