# New Dealer Alert Bot Configuration
# Copy to .env and adjust values

# Database path (SQLite)
DATABASE_PATH=data/dealer_alert.db

# Crawl settings
MAX_CONCURRENT_FETCHES=10
FETCH_TIMEOUT_SECONDS=30
CRAWL_DELAY_SECONDS=2
USER_AGENT=DealerAlertBot/1.0 (lead-research)
MAX_REDIRECTS=5

# Output settings
OUTPUT_DIR=data/digests
OUTPUT_FORMAT=both  # csv, json, or both

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/dealer_alert.log

# Expansion engine
AUTO_EXPAND=true
MAX_EXPANSION_DEPTH=2
MAX_NEW_SOURCES_PER_CRAWL=100

# Scoring thresholds
HOT_LEAD_MIN_MENTIONS=2
WARM_LEAD_KEYWORDS=hiring,construction,coming-soon,teaser

# Email collector (Gmail IMAP)
# 1. Enable 2FA on the Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-char app password below (spaces removed)
GMAIL_ADDRESS=newdealerchecker@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_FOLDER=INBOX
EMAIL_MAX_PER_RUN=100
EMAIL_MARK_READ=true

# Social monitor
SOCIAL_MAX_CONCURRENT=5
SOCIAL_DELAY_SECONDS=2
